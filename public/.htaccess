# Disable directory listing
Options -Indexes

# Enable URL rewriting
RewriteEngine On

# Handle PHP files directly
RewriteRule \.php$ - [L]

# If request is for an existing file, serve it
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Remove trailing slash (except root)
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# If request is a directory and a matching .html exists at root, serve it
# e.g. /grow/ or /grow -> serve /grow.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]

# If request has no extension and a matching .html exists, serve it
# e.g. /about -> serve /about.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]

# Fallback to 404 page
ErrorDocument 404 /404.html
