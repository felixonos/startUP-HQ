# Disable directory listing
Options -Indexes

# Enable URL rewriting
RewriteEngine On

# Serve existing files and directories directly (e.g. _next/static/, images/)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect old /grow route permanently to /creators-hub/
RewriteRule ^grow/?$ /creators-hub/ [R=301,L]

# Add trailing slash to extensionless paths (e.g. /about -> /about/)
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !\.\w+$
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# Fallback to 404 page
ErrorDocument 404 /404.html
